{
  "version": 2,
  "buildCommand": "echo 'Static deploy - no build needed'",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/vcsky/(.*)",
      "destination": "https://cdn.dos.zone/vcsky/$1"
    },
    {
      "source": "/vcbr/(.*)",
      "destination": "https://br.cdn.dos.zone/vcsky/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "functions": {
    "api/**": {
      "exclude": true
    }
  }
}
