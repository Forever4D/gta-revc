{
  "version": 2,
  "builds": [
    { "src": "dist/**", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/index.data",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/index.data"
    },
    {
      "src": "/index.wasm",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/index.wasm"
    },
    {
      "src": "/vcsky/(.*)",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/vcsky/$1"
    },
    {
      "src": "/vcbr/(.*)",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/vcbr/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}
