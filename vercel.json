{
  "version": 2,
  "builds": [
    { "src": "dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*\\.(?:data|wasm|mp3|wav|adf|txd|dff|dat|ifp|col|ipl|ide|cfg|zon|scm|sc|gxt))",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/$1"
    },
    {
      "src": "/vcsky/(.*)",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/vcsky/$1"
    },
    {
      "src": "/vcbr/(.*)",
      "dest": "https://gta-cors-proxy.f4d.workers.dev/vcbr/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}
